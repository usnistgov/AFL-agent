{
 "name": "color_matching",
 "date": "08/05/26 00:00:00-000000",
 "description": "A Bayesian optimization pipeline for matching a purple RGB target using four stock compositions.",
 "ops": [
  {
   "class": "AFL.double_agent.Generator.BarycentricGrid",
   "args": {
    "output_variable": "composition_grid",
    "components": [
     "stock_Red",
     "stock_Blue",
     "stock_Green",
     "stock_Yellow"
    ],
    "sample_dim": "grid",
    "grid_spec": {
     "stock_Red": {"min": 0.0, "max": 1.0},
     "stock_Blue": {"min": 0.0, "max": 1.0},
     "stock_Green": {"min": 0.0, "max": 1.0},
     "stock_Yellow": {"min": 0.0, "max": 1.0}
    },
    "pts_per_row": 41,
    "basis": 1.0,
    "dim": 4,
    "eps": 1e-09,
    "name": "BarycentricGridGenerator"
   }
  },
  {
   "class": "AFL.double_agent.PairMetric.TargetScore",
   "args": {
    "input_variable": "avg_rgb",
    "output_variable": "score",
    "target": [128, 0, 128],
    "sample_dim": "sample",
    "feature_dim": "channel",
    "name": "TargetScore"
   }
  },
  {
   "class": "AFL.double_agent.PyTorchExtrapolator.BoTorchRegressor",
   "args": {
    "feature_input_variable": "composition",
    "predictor_input_variable": "score",
    "output_prefix": "bayesopt",
    "grid_variable": "composition_grid",
    "grid_dim": "grid",
    "sample_dim": "sample",
    "objective_direction": "minimize",
    "standardize": true,
    "posterior_optimize": true,
    "posterior_optimize_restarts": 16,
    "posterior_optimize_raw_samples": 128,
    "bounds": {
     "stock_Red": {"min": 0.0, "max": 1.0},
     "stock_Blue": {"min": 0.0, "max": 1.0},
     "stock_Green": {"min": 0.0, "max": 1.0},
     "stock_Yellow": {"min": 0.0, "max": 1.0}
    },
    "is_simplex": true,
    "name": "BoTorchRegressor"
   }
  },
  {
   "class": "AFL.double_agent.AcquisitionFunction.BoTorchAcquisition",
   "args": {
    "feature_input_variable": "composition",
    "predictor_input_variable": "score",
    "grid_variable": "composition_grid",
    "bounds": {
     "stock_Red": {"min": 0.0, "max": 1.0},
     "stock_Blue": {"min": 0.0, "max": 1.0},
     "stock_Green": {"min": 0.0, "max": 1.0},
     "stock_Yellow": {"min": 0.0, "max": 1.0}
    },
    "grid_dim": "grid",
    "sample_dim": "sample",
    "objective_direction": "minimize",
    "standardize": true,
    "output_prefix": "bayesopt",
    "output_variable": "suggested_next_sample",
    "decision_rtol": 0.05,
    "excluded_comps_variables": ["composition"],
    "excluded_comps_dim": "component",
    "exclusion_radius": 0.02,
    "count": 1,
    "is_simplex": true,
    "acquisition_kind": "auto",
    "name": "BoTorchAcquisition"
   }
  }
 ]
}
